PORT=3000
NODE_ENV=development

# Redis Configuration (Use local or Upstash Serverless Redis)
REDIS_URL=redis://localhost:6379

# AWS Configuration (Used when running against live AWS resources)
AWS_REGION=us-east-1
DYNAMODB_EVENTS_TABLE=EventsInventory
DYNAMODB_BOOKINGS_TABLE=Bookings
DYNAMODB_IDEMPOTENCY_TABLE=IdempotencyKeys
SQS_QUEUE_URL=

# Hold window in seconds
RESERVATION_TTL_SECONDS=300
